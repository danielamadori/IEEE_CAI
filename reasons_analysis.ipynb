    "    print('Robustness summary (anti-reasons):')\n",
    "    print(f\"  • Mean robustness:   {robustness_stats['mean']:.4f}\")\n",
    "    print(f\"  • Median robustness: {robustness_stats['median']:.4f}\")\n",
    "    print(f\"  • Min / Max:        {robustness_stats['min']:.4f} / {robustness_stats['max']:.4f}\")\n",
    "    if test_accuracy is not None:\n",
    "        print('Accuracy vs robustness notes:')\n",
    "        print(f\"  • Accuracy gap (1 - mean robustness): {(1 - robustness_stats['mean']):.4f}\")\n",
    "        print(f\"  • Accuracy - mean robustness: {(test_accuracy - robustness_stats['mean']):.4f}\")\n",
    "else:\n",
    "    print('⚠️ Run robustness cell first to enable comparison.')"
